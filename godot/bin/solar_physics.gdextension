[configuration]
entry_symbol = "solar_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/solar_physics.so"
linux.release.x86_64 = "res://bin/solar_physics.so"
windows.debug.x86_64 = "res://bin/solar_physics.dll"
windows.release.x86_64 = "res://bin/solar_physics.dll"
